{
  "name": "shopping-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint \"packages/**/*.ts\" \"providers/**/*.ts\" \"tooling/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "provider-poc": "tsx tooling/provider-poc/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
