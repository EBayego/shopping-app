# Live Alcampo requests are opt-in and must use a legitimate short-lived browser session.
# Never commit real values or browser/network captures.
ALCAMPO_GLOBAL_SID=replace-with-short-lived-session-id
ALCAMPO_AWS_WAF_TOKEN=replace-with-short-lived-waf-token
ALCAMPO_CSRF_TOKEN=replace-with-short-lived-csrf-token
ALCAMPO_MARKET_ID=replace-with-confirmed-market-id
ALCAMPO_POSTAL_CODE=50009
