# Copy only the variables needed by the process you are running. Never commit
# populated .env files. APP_ENV changes release metadata, not credentials.
APP_ENV=development
EXPO_PUBLIC_APP_SCHEME=shopping-app-dev

# Mobile (public values embedded in the Expo bundle)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-public-anon-or-publishable-key

# Backend ingestion/scheduler (server only)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key
REFRESH_WORKER_ID=local-ingestion-worker

# Internal admin (server only)
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_PORT=4010

# Live provider tests are opt-in and are never part of the default test gate.
RUN_LIVE_PROVIDER_TESTS=false
